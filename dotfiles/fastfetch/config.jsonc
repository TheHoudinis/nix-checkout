{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "nixos",
    "color": {
      "1": "#D4D4D4",
      "2": "#C4C4C4",
      "3": "#B8B8B8",
      "4": "#C4C4C4",
      "5": "#B8B8B8",
      "6": "#D4D4D4"
    },
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "#c7c7c7",
      "title": "#c7c7c7",
      "separator": "#757575",
      "output": "#e5e5e5"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "format": "{name} {version-id}"
    },
    {
      "type": "host",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "format": "{release}"
    },
    "uptime",
    {
      "type": "packages",
      "format": "{all}"
    },
    {
      "type": "shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "display",
      "key": "Display",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    {
      "type": "wm",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "command",
      "key": "CPU",
      "text": "LC_ALL=C lscpu | sed -n 's/^Model name:[[:space:]]*//p' | sed 's/(R)//g; s/(TM)//g'"
    },
    {
      "type": "gpu",
      "format": "{name}"
    },
    {
      "type": "memory",
      "format": "{used} / {total}"
    },
    {
      "type": "swap",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "Disk",
      "format": "{size-used} / {size-total}"
    }
  ]
}
