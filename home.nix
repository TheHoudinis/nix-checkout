{ config, pkgs, ... }:

let
  # Packages the Nordic cursor theme from ./cursors/Nordic-cursors
  # (keep that folder next to this file in /etc/nixos).
  nordicCursors = pkgs.runCommand "nordic-cursors" { } ''
    mkdir -p $out/share/icons
    cp -r ${./cursors/Nordic-cursors} $out/share/icons/Nordic-cursors
  '';
in
{
  home.username = "houdini";
  home.homeDirectory = "/home/houdini";

  # Do NOT change this after first use.
  home.stateVersion = "26.05";

  programs.home-manager.enable = true;

  # ── Cursor ──────────────────────────────────────────────────────────
  home.pointerCursor = {
    name = "Nordic-cursors";
    package = nordicCursors;
    size = 24;
    gtk.enable = true; # GTK apps
    x11.enable = true; # XWayland apps (Steam, games)
  };

  home.sessionVariables = {
    XCURSOR_THEME = "Nordic-cursors";
    XCURSOR_SIZE = "24";
  };

  # ── Dotfiles ────────────────────────────────────────────────────────
  # Your existing files, linked as-is from /etc/nixos/dotfiles so nothing
  # is lost in translation. Edit them there, then rebuild.
  xdg.configFile."kitty/kitty.conf".source = ./dotfiles/kitty/kitty.conf;
  xdg.configFile."fish/config.fish".source = ./dotfiles/fish/config.fish;
  xdg.configFile."fastfetch/config.jsonc".source = ./dotfiles/fastfetch/config.jsonc;

  # Hyprland. hypr/scheme/current.lua is generated by Caelestia, so it is
  # deliberately NOT managed here.
  xdg.configFile."hypr/hyprland.lua".source = ./dotfiles/hypr/hyprland.lua;

  # ── Flatpak apps (per-user install, same place as before) ───────────
  services.flatpak = {
    enable = true;
    packages = [
      "com.spotify.Client" # Spicetify patches this one
      "org.vinegarhq.Sober"
    ];
  };

  # ── Vesktop ─────────────────────────────────────────────────────────
  # Only enabled plugins are listed; everything else stays at its default (off).
  # Themes (caelestia.theme.css) and quickCss.css are left alone: Caelestia
  # regenerates the theme.
  programs.vesktop = {
    enable = true;
    vencord.settings = {
      autoUpdate = false; # the Nix store is read-only; updates come from nixpkgs
      autoUpdateNotification = false;
      useQuickCss = true;
      enabledThemes = [ "caelestia.theme.css" ];
      frameless = false;
      transparent = true;
      notifications = {
        timeout = 5000;
        position = "bottom-right";
        useNative = "not-focused";
        logLimit = 50;
      };
      plugins = {
        BadgeAPI.enabled = true;
        CommandsAPI.enabled = true;
        ContextMenuAPI.enabled = true;
        MessageAccessoriesAPI.enabled = true;
        MessageEventsAPI.enabled = true;
        NoticesAPI.enabled = true;
        UserSettingsAPI.enabled = true;
        ConcatenatedComponentExtractor.enabled = true;
        CrashHandler.enabled = true;
        DisableDeepLinks.enabled = true;
        FakeNitro.enabled = true;
        FixDiscordCss.enabled = true;
        SupportHelper.enabled = true;
        VolumeBooster.enabled = true;
        WebContextMenus.enabled = true;
        WebScreenShareFixes.enabled = true;
        WebKeybinds = {
          enabled = true;
          showNavigationButtons = true;
          overrideCommonKeybinds = true;
        };
        NoTrack = {
          enabled = true;
          disableAnalytics = true;
        };
        Settings = {
          enabled = true;
          settingsLocation = "aboveNitro";
          includeVencordInfoWhenCopying = true;
        };
      };
    };
  };
}
